diff --git a/src/panfrost/meson.build b/src/panfrost/meson.build
index cb928b1..6779cd6 100644
--- a/src/panfrost/meson.build
+++ b/src/panfrost/meson.build
@@ -41,12 +41,33 @@ endif
 
 subdir('compiler')
 
-if with_gallium_panfrost or with_panfrost_vk or with_tools.contains('panfrost')
-  subdir('clc')
+if get_option('s21-prebuilt-shaders')
+  # PAN_ARCH=9 only (S21 Mali-G78). The prebuilt files are generated from
+  # src/panfrost/libpan/*.cl by mesa_clc + vtn_bindgen2 + panfrost_compile on
+  # a Linux x86_64 host and copied into src/panfrost/libpan/prebuilt-v9/ by
+  # the S21 userland CI job.
+  idep_libpan_per_arch = {}
+  idep_libpan_cur_ver = declare_dependency(
+    sources : files(
+      'libpan/prebuilt-v9/libpan_v9.cpp',
+      'libpan/prebuilt-v9/libpan_v9.h',
+      'libpan/prebuilt-v9/libpan_shaders_v9.c',
+      'libpan/prebuilt-v9/libpan_shaders_v9.h',
+    ),
+    include_directories : include_directories('libpan/prebuilt-v9'),
+  )
+  idep_libpan_per_arch += {'9' : idep_libpan_cur_ver}
+else
+  if with_gallium_panfrost or with_panfrost_vk or with_tools.contains('panfrost')
+    subdir('clc')
+  endif
+
+  if with_gallium_panfrost or with_panfrost_vk
+     subdir('libpan')
+  endif
 endif
 
 if with_gallium_panfrost or with_panfrost_vk
-   subdir('libpan')
    subdir('perf')
 endif
 
