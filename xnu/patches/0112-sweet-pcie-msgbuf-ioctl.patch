+/* ---- Stage 4/5: polled msgbuf control path (rings, IOCTL, CLM) -------------
+ * Mirrors brcmf_pcie_init_ringbuffers/scratchbuffers + msgbuf tx_ioctl.
+ * No interrupts: completions are polled.  All host memory lives in the S2MPU
+ * window opened by stage 2 (0x92400000, 16 MiB); bus address == CPU physical.
+ * sweetpcie=4: rings + `ver` + `cur_etheraddr`.  sweetpcie=5: also clmload.
+ * Ring max-items / item sizes are from mainline brcmfmac (msgbuf headers were
+ * not in the Linux bundle): ctl-submit 64x40, rxpost 1024x32, ctl-cmplt 64x24,
+ * tx-cmplt 1024x(16|24), rx-cmplt 1024x(32|40), the 2nd value for shared ver>=7.
+ */
+static uint32_t swp_pcie_core, swp_level;
+
+#define S4_IDX_OFF	0x000000u
+#define S4_IDX_MAX	0x010000u
+#define S4_SCRATCH_OFF	0x020000u
+#define S4_RINGUPD_OFF	0x021000u
+#define S4_REQ_OFF	0x030000u
+#define S4_RESP_OFF	0x040000u	/* 8 x 8 KiB */
+#define S4_EVT_OFF	0x0a0000u	/* 8 x 8 KiB */
+#define S4_BUFSZ	0x2000u
+#define S4_ZERO_END	0x0b0000u
+#define S4_IOCTL_MAX	1518u
+#define S4_REQ_PKTID	0xfffeu
+
+struct s4ring { uint32_t max, isz, hoff, w_idx, r_idx, wp, rp; };
+static struct s4ring s4r[5];
+static volatile uint8_t *s4h;
+static uint32_t s4_idx_sz, s4_trans;
+
+static const uint32_t s4_max[5] = { 64, 1024, 64, 1024, 1024 };
+static const uint32_t s4_isz_pre7[5] = { 40, 32, 24, 16, 32 };
+static const uint32_t s4_isz_v7[5] = { 40, 32, 24, 24, 40 };
+static const uint32_t s4_hoff[5] = { 0x50000, 0x60000, 0x70000, 0x80000, 0x90000 };
+
+static inline uint8_t h_r8(uint32_t o) { return s4h[o]; }
+static inline uint16_t h_r16(uint32_t o) { return *(volatile uint16_t *)(s4h + o); }
+static inline uint32_t h_r32(uint32_t o) { return *(volatile uint32_t *)(s4h + o); }
+static inline void h_w8(uint32_t o, uint8_t v) { s4h[o] = v; }
+static inline void h_w16(uint32_t o, uint16_t v) { *(volatile uint16_t *)(s4h + o) = v; }
+static inline void h_w32(uint32_t o, uint32_t v) { *(volatile uint32_t *)(s4h + o) = v; }
+
+static uint32_t swp_tcm_read16(uint32_t addr)
+{
+	volatile uint8_t *t = (volatile uint8_t *)P.mem + (uint32_t)(P.bar_base[2] - PA_MEM);
+
+	return *(volatile uint16_t *)(t + addr);
+}
+
+static void swp_tcm_write16(uint32_t addr, uint32_t v)
+{
+	volatile uint8_t *t = (volatile uint8_t *)P.mem + (uint32_t)(P.bar_base[2] - PA_MEM);
+
+	*(volatile uint16_t *)(t + addr) = (uint16_t)v;
+}
+
+static uint32_t s4_rd_idx(uint32_t addr)
+{
+	if (s4_idx_sz == 0)
+		return swp_tcm_read16(addr);
+	return s4_idx_sz == 2 ? h_r16(addr) : h_r32(addr);
+}
+
+static void s4_wr_idx(uint32_t addr, uint32_t v)
+{
+	if (s4_idx_sz == 0)
+		swp_tcm_write16(addr, v);
+	else if (s4_idx_sz == 2)
+		h_w16(addr, (uint16_t)v);
+	else
+		h_w32(addr, v);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void s4_bell(void) { swp_bp_write(swp_pcie_core + 0x140, 1); }
+
+/* returns host-pool offset of the next free item (zeroed), or ~0u if full */
+static uint32_t s4_reserve(struct s4ring *r)
+{
+	uint32_t next = (r->wp + 1) % r->max, o, i;
+
+	r->rp = s4_rd_idx(r->r_idx);
+	if (next == r->rp)
+		return ~0u;
+	o = r->hoff + r->wp * r->isz;
+	for (i = 0; i < r->isz; i += 4)
+		h_w32(o + i, 0);
+	return o;
+}
+
+static void s4_commit(struct s4ring *r)
+{
+	r->wp = (r->wp + 1) % r->max;
+	__asm__ volatile("dsb sy" ::: "memory");
+	s4_wr_idx(r->w_idx, r->wp);
+	s4_bell();
+}
+
+static int s4_rings_init(uint32_t shared, uint32_t flags)
+{
+	uint32_t ri = swp_tcm_read32(shared + 48), ringmem, ver = flags & 0xffu;
+	uint32_t maxsub, maxflow, maxcomp, off, i, bufsz;
+	uint32_t hw, hr, dw, dr;	/* index locations */
+	const uint32_t *isz = ver >= 7 ? s4_isz_v7 : s4_isz_pre7;
+
+	if (ri < SWP_BRCMF_RAMBASE || ri + 58 > SWP_BRCMF_RAMBASE + P.bar_size[2]) {
+		SWP_LOG("S4: bad ring_info addr 0x%x", ri);
+		return -1;
+	}
+	ringmem = swp_tcm_read32(ri);
+	if (ver >= 6) {
+		maxflow = swp_tcm_read16(ri + 52);
+		maxsub = swp_tcm_read16(ri + 54);
+		maxcomp = swp_tcm_read16(ri + 56);
+	} else {
+		maxsub = swp_tcm_read16(ri + 52);
+		maxflow = maxsub - 2;
+		maxcomp = 3;
+	}
+	SWP_LOG("S4: ring_info 0x%x ringmem 0x%x submit %u complete %u flow %u", ri, ringmem,
+	    maxsub, maxcomp, maxflow);
+	if (maxsub < 2 || maxcomp < 3 || maxflow > 512) {
+		SWP_LOG("S4: implausible ring counts");
+		return -1;
+	}
+	s4_idx_sz = 0;
+	if (flags & 0x10000u)
+		s4_idx_sz = (flags & 0x100000u) ? 2 : 4;
+	if (s4_idx_sz) {
+		bufsz = (maxsub + maxcomp) * s4_idx_sz * 2;
+		if (bufsz > S4_IDX_MAX) {
+			SWP_LOG("S4: index buffer too big (%u)", bufsz);
+			return -1;
+		}
+		hw = S4_IDX_OFF;
+		hr = hw + maxsub * s4_idx_sz;
+		dw = hr + maxsub * s4_idx_sz;
+		dr = dw + maxcomp * s4_idx_sz;
+		/* ringinfo: h2d_w, h2d_r, d2h_w, d2h_r host addresses, low/high pairs at +20 */
+		off = 20;
+		{
+			uint64_t pa[4];
+
+			pa[0] = SWP_DMA_BASE + hw;
+			pa[1] = SWP_DMA_BASE + hr;
+			pa[2] = SWP_DMA_BASE + dw;
+			pa[3] = SWP_DMA_BASE + dr;
+			for (i = 0; i < 4; i++) {
+				swp_tcm_write32(ri + off + 8 * i, (uint32_t)pa[i]);
+				swp_tcm_write32(ri + off + 8 * i + 4, (uint32_t)(pa[i] >> 32));
+			}
+		}
+		SWP_LOG("S4: DMA ring indices, %u-byte", s4_idx_sz);
+	} else {
+		hw = swp_tcm_read32(ri + 4);
+		hr = swp_tcm_read32(ri + 8);
+		dw = swp_tcm_read32(ri + 12);
+		dr = swp_tcm_read32(ri + 16);
+		SWP_LOG("S4: TCM ring indices");
+	}
+	for (i = 0; i < 5; i++) {
+		struct s4ring *r = &s4r[i];
+		uint32_t rm = ringmem + i * 16, idx = (i < 2) ? i : i - 2, step = s4_idx_sz ? s4_idx_sz : 4;
+		uint64_t pa = SWP_DMA_BASE + s4_hoff[i];
+
+		r->max = s4_max[i];
+		r->isz = isz[i];
+		r->hoff = s4_hoff[i];
+		r->wp = r->rp = 0;
+		r->w_idx = (i < 2 ? hw : dw) + idx * step;
+		r->r_idx = (i < 2 ? hr : dr) + idx * step;
+		swp_tcm_write32(rm + 8, (uint32_t)pa);
+		swp_tcm_write32(rm + 12, (uint32_t)(pa >> 32));
+		swp_tcm_write16(rm + 4, r->max);
+		swp_tcm_write16(rm + 6, r->isz);
+	}
+	return 0;
+}
+
+static void s4_scratch_init(uint32_t shared)
+{
+	uint64_t a = SWP_DMA_BASE + S4_SCRATCH_OFF, b = SWP_DMA_BASE + S4_RINGUPD_OFF;
+
+	swp_tcm_write32(shared + 56, (uint32_t)a);
+	swp_tcm_write32(shared + 60, (uint32_t)(a >> 32));
+	swp_tcm_write32(shared + 52, 8);
+	swp_tcm_write32(shared + 68, (uint32_t)b);
+	swp_tcm_write32(shared + 72, (uint32_t)(b >> 32));
+	swp_tcm_write32(shared + 64, 1024);
+}
+
+static int s4_post_buf(int evt, uint32_t idx)
+{
+	struct s4ring *r = &s4r[0];
+	uint32_t o = s4_reserve(r);
+	uint64_t pa = SWP_DMA_BASE + (evt ? S4_EVT_OFF : S4_RESP_OFF) + idx * S4_BUFSZ;
+
+	if (o == ~0u)
+		return -1;
+	h_w8(o, evt ? 0x0d : 0x0b);
+	h_w32(o + 4, evt ? 0x100 + idx : 1 + idx);
+	h_w16(o + 8, S4_BUFSZ);
+	h_w32(o + 16, (uint32_t)pa);
+	h_w32(o + 20, (uint32_t)(pa >> 32));
+	s4_commit(r);
+	return 0;
+}
+
+/* One IOCTL, polled.  Returns 0 and fills out/rlen/status on a completion. */
+static int s4_ioctl(uint32_t cmd, const uint8_t *in, uint32_t inlen, uint32_t outlen,
+    uint8_t *out, uint32_t *rlen, int *status)
+{
+	struct s4ring *c = &s4r[0], *d = &s4r[2];
+	uint32_t o, i, t, wp;
+	int done = 0, repost = -1;
+	static int seen;
+
+	if (inlen > S4_IOCTL_MAX || outlen > S4_IOCTL_MAX)
+		return -1;
+	for (i = 0; i < inlen; i++)
+		h_w8(S4_REQ_OFF + i, in[i]);
+	o = s4_reserve(c);
+	if (o == ~0u) {
+		SWP_LOG("S4: control submit ring full");
+		return -1;
+	}
+	h_w8(o, 0x09);
+	h_w32(o + 4, S4_REQ_PKTID);
+	h_w32(o + 8, cmd);
+	h_w16(o + 12, (uint16_t)++s4_trans);
+	h_w16(o + 14, (uint16_t)inlen);
+	h_w16(o + 16, (uint16_t)outlen);
+	h_w32(o + 24, (uint32_t)(SWP_DMA_BASE + S4_REQ_OFF));
+	h_w32(o + 28, (uint32_t)((SWP_DMA_BASE + S4_REQ_OFF) >> 32));
+	s4_commit(c);
+
+	for (t = 0; t < 2000 && !done; t++) {
+		wp = s4_rd_idx(d->w_idx);
+		if (wp >= d->max) {
+			SWP_LOG("S4: bad complete wptr %u", wp);
+			return -1;
+		}
+		if (wp != d->rp) {
+			while (d->rp != wp) {
+				uint32_t io = d->hoff + d->rp * d->isz;
+				uint8_t ty = h_r8(io);
+
+				if (ty == 0x0c) {
+					uint32_t rid = h_r32(io + 4), rl = h_r16(io + 12), n;
+
+					*status = (int16_t)h_r16(io + 8);
+					*rlen = rl;
+					if (rid >= 1 && rid <= 8) {
+						uint32_t b = S4_RESP_OFF + (rid - 1) * S4_BUFSZ;
+
+						n = rl < outlen ? rl : outlen;
+						for (i = 0; i < n; i++)
+							out[i] = h_r8(b + i);
+						repost = (int)(rid - 1);
+					} else {
+						SWP_LOG("S4: ioctl cmplt with odd request id %u", rid);
+					}
+					done = 1;
+				} else if (ty != 0x0a && seen++ < 8) {
+					SWP_LOG("S4: ctl-complete msgtype 0x%x", ty);
+				}
+				d->rp = (d->rp + 1) % d->max;
+			}
+			s4_wr_idx(d->r_idx, d->rp);
+		}
+		if (!done)
+			swp_mdelay(1);
+	}
+	if (repost >= 0)
+		s4_post_buf(0, (uint32_t)repost);
+	return done ? 0 : -2;
+}
+
+static int s4_iovar_get(const char *name, uint32_t outlen, uint8_t *out, uint32_t *rlen)
+{
+	uint8_t buf[S4_IOCTL_MAX];
+	uint32_t n = 0, i;
+	int st = 0, r;
+
+	while (name[n] && n < 60)
+		n++;
+	for (i = 0; i < outlen; i++)
+		buf[i] = 0;
+	for (i = 0; i < n; i++)
+		buf[i] = (uint8_t)name[i];
+	r = s4_ioctl(262, buf, outlen, outlen, out, rlen, &st);	/* WLC_GET_VAR */
+	if (r) {
+		SWP_LOG("S4: get %s: %s", name, r == -2 ? "timeout" : "submit failed");
+		return -1;
+	}
+	if (st) {
+		SWP_LOG("S4: get %s: firmware status %d", name, st);
+		return -1;
+	}
+	return 0;
+}
+
+static int s4_clm_load(void)
+{
+	const uint8_t *clm = (const uint8_t *)phystokv((pmap_paddr_t)swp_clm_pa);
+	uint8_t buf[8 + 12 + 1400], out[64];
+	uint32_t len = (uint32_t)swp_clm_len, off = 0, n, i, rl, chunks = 0;
+	uint16_t flag = 0x0002;	/* DL_BEGIN */
+	int st = 0, r;
+	static const char name[8] = "clmload";
+
+	for (i = 0; i < 8; i++)
+		buf[i] = (uint8_t)name[i];
+	while (off < len) {
+		n = len - off > 1400 ? 1400 : len - off;
+		if (len - off <= 1400)
+			flag |= 0x0004;	/* DL_END */
+		{
+			uint16_t f = flag | (1u << 12);	/* DLOAD_HANDLER_VER 1 << shift 12 */
+
+			buf[8] = (uint8_t)f; buf[9] = (uint8_t)(f >> 8);
+			buf[10] = 2; buf[11] = 0;	/* DL_TYPE_CLM */
+			buf[12] = (uint8_t)n; buf[13] = (uint8_t)(n >> 8);
+			buf[14] = buf[15] = 0;
+			buf[16] = buf[17] = buf[18] = buf[19] = 0;	/* crc */
+		}
+		for (i = 0; i < n; i++)
+			buf[20 + i] = clm[off + i];
+		r = s4_ioctl(263, buf, 20 + n, 20 + n, out, &rl, &st);	/* WLC_SET_VAR */
+		if (r || st) {
+			SWP_LOG("S4: clmload chunk %u at %u failed (r=%d fw status %d)", chunks, off, r, st);
+			if (!s4_iovar_get("clmload_status", 8, out, &rl))
+				SWP_LOG("S4: clmload_status %u", (uint32_t)out[0] | ((uint32_t)out[1] << 8));
+			return -1;
+		}
+		flag &= ~0x0002;
+		off += n;
+		chunks++;
+	}
+	SWP_LOG("S4: clmload sent %u bytes in %u chunks", len, chunks);
+	if (!s4_iovar_get("clmload_status", 8, out, &rl))
+		SWP_LOG("S4: clmload_status %u (0 = ok)", (uint32_t)out[0] | ((uint32_t)out[1] << 8));
+	return 0;
+}
+
+static int s4_run(uint32_t shared, uint32_t flags)
+{
+	uint8_t out[256];
+	uint32_t rl = 0, i;
+	char line[96];
+
+	if (!swp_pcie_core) {
+		SWP_LOG("S4: PCIe2 core not found");
+		return -1;
+	}
+	s4h = (volatile uint8_t *)swp_map(SWP_DMA_BASE, SWP_DMA_SIZE);
+	if (!s4h) {
+		SWP_LOG("S4: pool map failed");
+		return -1;
+	}
+	for (i = 0; i < S4_ZERO_END; i += 4)
+		h_w32(i, 0);
+	if (s4_rings_init(shared, flags))
+		return -1;
+	s4_scratch_init(shared);
+	if (flags & 0x10000000u)
+		swp_bp_write(swp_pcie_core + 0x144, 1);	/* H2D mailbox 1: host ready */
+	for (i = 0; i < 8; i++)
+		if (s4_post_buf(0, i) || s4_post_buf(1, i)) {
+			SWP_LOG("S4: posting ioctl-response/event buffers failed at %u", i);
+			return -1;
+		}
+	SWP_LOG("S4: rings up, 8 ioctl-resp + 8 event buffers posted");
+
+	if (s4_iovar_get("ver", 256, out, &rl))
+		return -1;
+	for (i = 0; i < sizeof(line) - 1 && i < rl && out[i] && out[i] != '\n'; i++)
+		line[i] = (out[i] >= 32 && out[i] < 127) ? (char)out[i] : '.';
+	line[i] = '\0';
+	SWP_LOG("S4: fw ver: %s", line);
+	if (!s4_iovar_get("cur_etheraddr", 32, out, &rl))
+		SWP_LOG("S4: cur_etheraddr %02x:%02x:%02x:%02x:%02x:%02x (len %u)",
+		    out[0], out[1], out[2], out[3], out[4], out[5], rl);
+	if (swp_level >= 5)
+		return s4_clm_load();
+	return 0;
+}
