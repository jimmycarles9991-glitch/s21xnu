diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index e1b1a24..8c5d0d2 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -356,6 +356,7 @@ sweet_touch_post(struct ts_touch *t, uint32_t flip)
 static int ts_g_trace, ts_g_flip;
 static uint32_t ts_g_poll_us;
 static int ts_g_ev;
+static int ts_g_burst = 32; /* 0098: events drained per poll; touch_burst=1 = old behaviour */
 
 static void
 ts_block_us(uint32_t us)
@@ -374,7 +375,7 @@ sweet_touch_poll(void *arg, wait_result_t w)
 	note("TSPOLL thread start poll_us=%u", ts_g_poll_us);
 	for (;;) {
 		polls++;
-		if (pin_get(attn_va, ATTN_BIT) == 0) {
+		for (int burst = 0; burst < ts_g_burst && pin_get(attn_va, ATTN_BIT) == 0; burst++) {
