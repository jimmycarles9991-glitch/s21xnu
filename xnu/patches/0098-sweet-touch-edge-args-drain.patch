 			lows++;
 			cmd = SEC_TS_READ_ONE_EVENT;
@@ -419,6 +420,13 @@ sweet_touch_init(void)
 	PE_parse_boot_argn("touch_flip", &touch_flip, sizeof(touch_flip));
 	PE_parse_boot_argn("touch_trace", &touch_trace, sizeof(touch_trace));
 	PE_parse_boot_argn("touch_poll_us", &touch_poll_us, sizeof(touch_poll_us));
+	{
+		int burst = 0;
+		if (PE_parse_boot_argn("touch_burst", &burst, sizeof(burst)) && burst >= 1 && burst <= 256) {
+			ts_g_burst = burst;
+		}
+		note("0098 burst=%d", ts_g_burst);
+	}
 
 	ts_bus_va   = ml_io_map(TS_BUS_BASE, 0x20);
 	pmic_bus_va = ml_io_map(PMIC_BUS_BASE, 0x20);
