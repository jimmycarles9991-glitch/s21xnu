diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
index 3967513..679c7a4 100644
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -357,6 +357,26 @@ OSDefineMetaClassAndStructors(SweetHIDButtons, IOHIDEventService);
  */
 #define SWEET_TOUCH_EDGE_PX 48
 #define SWEET_TOUCH_EDGE_BOTTOM_PX 100
+static int gSweetEdgePx = SWEET_TOUCH_EDGE_PX;
+static int gSweetEdgeBottomPx = SWEET_TOUCH_EDGE_BOTTOM_PX;
+/* 0098: boot-args touch_edge=N (sides/top) and touch_edge_bottom=N, in panel px. */
+static void
+sweetTouchEdgeInit(void)
+{
+	static bool done;
+	int v = 0;
+	if (done) {
+		return;
+	}
+	done = true;
+	if (PE_parse_boot_argn("touch_edge", &v, sizeof(v)) && v >= 0 && v <= 1000) {
+		gSweetEdgePx = v;
+	}
+	if (PE_parse_boot_argn("touch_edge_bottom", &v, sizeof(v)) && v >= 0 && v <= 1000) {
+		gSweetEdgeBottomPx = v;
+	}
+	IOLog("SWEET TOUCHEDGE v1: edge %d bottom %d\n", gSweetEdgePx, gSweetEdgeBottomPx);
+}
