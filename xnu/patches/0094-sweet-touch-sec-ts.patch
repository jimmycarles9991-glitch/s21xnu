+/*
+ * Touchscreen for the S21+ (Exynos 2100): Samsung LSI sec_ts-family controller
+ * (kernel driver identifies as "slsi_ts", DT compatible "slsi,slsi_ts") at I2C
+ * address 0x48. Protocol and event layout confirmed identical to sec_ts
+ * (SEC_TS_CMD_* opcodes, struct sec_ts_event_coordinate bit layout) against
+ * the real vendor source (kernel/drivers/input/touchscreen/sec_ts/sec_ts.h on
+ * the s21 Linux tree) -- not assumed from the S20+ driver.
+ *
+ * Bus is bit-banged, same as the S20+ y2sios redwood_sec_ts.c: no USI/HSI2C
+ * controller driver exists in XNU, and bit-banging sidesteps needing one.
+ *
+ * All register addresses below are verified against the live S21+ hardware:
+ * exynos2100-t2s-firstlight-v32.dts (node literal), /sys/kernel/debug/gpio
+ * (live binding -- this is what caught gpa1 actually living under 0x14ec0000,
+ * not 0x14e30000 as the DTS node nesting alone would suggest), and
+ * kernel/drivers/pinctrl/samsung/pinctrl-exynos-arm64.c (exynos2100_pin_*
+ * bank tables + exynos9810_bank_type_off/alive reg_offset[]). Do not trust
+ * the DTS node nesting over the debugfs-confirmed live parent if they ever
+ * disagree again.
+ *
+ * Touch I2C bus:  gpp4-0 (SDA) / gpp4-1 (SCL), PERIC0, bank +0x80
+ *   CON 0x10430080  DAT 0x10430084  PUD 0x10430088
+ * ATTN (low = events pending): gpa1-0, CMGPEINT, bank +0x20
+ *   CON 0x14ec0020  DAT 0x14ec0024  PUD 0x14ec0028
+ * PMIC I2C bus (S2DOS05 @ 0x60): gpp0-2 (SCL) / gpp0-3 (SDA), PERIC0, +0x00
+ *   CON 0x10430000  DAT 0x10430004  PUD 0x10430008
+ *
+ * S2DOS05 LDO2 = tsp_io (1.8V), LDO3 = tsp_avdd (3.0V) -- same chip, same
+ * LDO assignment as the S20+. On THIS board both are DT regulator-boot-on +
+ * regulator-always-on, so touch_pwr=0 (skip the power sequence) is worth
+ * trying first; the bootloader may already have them on. Fall back to
+ * touch_pwr=1 (our own power-up) or 2 (power-cycle) if the probe below
+ * reads back garbage.
+ *
+ * Boot arguments (nothing touched unless touch_ts is given -- same shape as
+ * the S20+ driver's args, see docs/history/TOUCH.md in the y2sios tree):
+ *
+ *   touch_ts=1       power, probe, then poll and post touches
+ *   touch_ts=2       probe only, then panic with a one-line summary (use
+ *                    this first: the panic is what gets the log off this
+ *                    phone, same as every other SWEET bring-up patch)
+ *   touch_ts=3       probe only, no polling, no panic
+ *   touch_pwr=N      0 leave S2DOS05 alone (try first), 1 power up, 2
+ *                    power-cycle first
+ *   touch_poll_us=N  how often ATTN is sampled (default 8000us)
+ *   touch_flip=N     bit0 mirrors X, bit1 mirrors Y (panel is 1080x2400,
+ *                    4096x4096 raw space per nTX:18/nRX:40, rX/rY:4095 from
+ *                    the live sec_input probe log)
+ *   touch_trace=1    print every decoded event
+ *
+ * NOT YET WIRED: posting into whatever SWEET's own HID stand-in expects.
+ * I have not seen sweet_keys.c or the real posting entry point on this tree
+ * (the handoff only shows it exists, patch 0060, now dead/Qualcomm-only).
+ * sweet_touch_post() below is a stub -- fill in the real call once you paste
+ * back sweet_keys.c or whatever SWEET uses for synthetic input today.
+ */
+
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <stdarg.h>
+#include <sys/systm.h>
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+/* ------------------------------------------------------------------------ */
+/* GPIO bit-bang, verified Exynos 2100 register map (see header comment)    */
+
+#define TS_BUS_BASE   0x10430080U   /* gpp4, PERIC0 +0x80 */
+#define PMIC_BUS_BASE 0x10430000U   /* gpp0, PERIC0 +0x00 */
+#define ATTN_BASE     0x14ec0020U   /* gpa1, CMGPEINT +0x20 */
+
+#define REG_CON  0x00U
+#define REG_DAT  0x04U
+#define REG_PUD  0x08U
+
+#define TS_SDA_BIT   0U   /* gpp4-0 */
+#define TS_SCL_BIT   1U   /* gpp4-1 */
+#define PMIC_SCL_BIT 2U   /* gpp0-2 */
+#define PMIC_SDA_BIT 3U   /* gpp0-3 */
+#define ATTN_BIT     0U   /* gpa1-0 */
+
+#define FUNC_INPUT  0x0U
+#define FUNC_OUTPUT 0x1U
+
+static vm_offset_t ts_bus_va, pmic_bus_va, attn_va;
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static inline void
+pin_func(vm_offset_t bank_va, uint32_t bit, uint32_t func)
+{
+	uint32_t v = *(volatile uint32_t *)(bank_va + REG_CON);
+	v &= ~(0xFU << (bit * 4));
+	v |= (func & 0xFU) << (bit * 4);
+	*(volatile uint32_t *)(bank_va + REG_CON) = v;
+}
+
+static inline void
+pin_set(vm_offset_t bank_va, uint32_t bit, int level)
+{
+	uint32_t v = *(volatile uint32_t *)(bank_va + REG_DAT);
+	if (level) {
+		v |= (1U << bit);
+	} else {
+		v &= ~(1U << bit);
+	}
+	*(volatile uint32_t *)(bank_va + REG_DAT) = v;
+}
+
+static inline int
+pin_get(vm_offset_t bank_va, uint32_t bit)
+{
+	return (*(volatile uint32_t *)(bank_va + REG_DAT) >> bit) & 1;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Bit-banged I2C (open-drain: low = drive 0, "high" = switch to input and   */
+/* let the board's pull-up raise it -- same approach as redwood_sec_ts.c)   */
+
+struct bbi2c {
+	vm_offset_t bank_va;
+	uint32_t    scl_bit, sda_bit;
+};
+
+static void
+i2c_scl(struct bbi2c *b, int high)
+{
+	pin_func(b->bank_va, b->scl_bit, high ? FUNC_INPUT : FUNC_OUTPUT);
+	if (!high) {
+		pin_set(b->bank_va, b->scl_bit, 0);
+	}
+}
+
+static void
+i2c_sda(struct bbi2c *b, int high)
+{
+	pin_func(b->bank_va, b->sda_bit, high ? FUNC_INPUT : FUNC_OUTPUT);
+	if (!high) {
+		pin_set(b->bank_va, b->sda_bit, 0);
+	}
+}
+
+static void
+i2c_start(struct bbi2c *b)
+{
+	i2c_sda(b, 1); i2c_scl(b, 1); sleep_us(5);
+	i2c_sda(b, 0); sleep_us(5);
+	i2c_scl(b, 0); sleep_us(5);
+}
+
+static void
+i2c_stop(struct bbi2c *b)
+{
+	i2c_sda(b, 0); sleep_us(5);
+	i2c_scl(b, 1); sleep_us(5);
+	i2c_sda(b, 1); sleep_us(5);
+}
+
+/* returns ACK (0) or NAK (1) */
+static int
+i2c_wbyte(struct bbi2c *b, uint8_t byte)
+{
+	int ack;
+	for (int i = 7; i >= 0; i--) {
+		i2c_sda(b, (byte >> i) & 1);
+		sleep_us(2);
+		i2c_scl(b, 1); sleep_us(3);
+		i2c_scl(b, 0); sleep_us(2);
+	}
+	i2c_sda(b, 1);
+	i2c_scl(b, 1); sleep_us(3);
+	ack = pin_get(b->bank_va, b->sda_bit);
+	i2c_scl(b, 0); sleep_us(2);
+	return ack;
+}
+
+static uint8_t
+i2c_rbyte(struct bbi2c *b, int ack)
+{
+	uint8_t v = 0;
+	i2c_sda(b, 1);
+	for (int i = 7; i >= 0; i--) {
+		i2c_scl(b, 1); sleep_us(3);
+		v = (uint8_t)((v << 1) | pin_get(b->bank_va, b->sda_bit));
+		i2c_scl(b, 0); sleep_us(2);
+	}
+	i2c_sda(b, !ack);
+	i2c_scl(b, 1); sleep_us(3);
+	i2c_scl(b, 0); sleep_us(2);
+	i2c_sda(b, 1);
+	return v;
+}
+
+static int
+i2c_write(struct bbi2c *b, uint8_t addr, const uint8_t *data, int len)
+{
+	i2c_start(b);
+	if (i2c_wbyte(b, (uint8_t)(addr << 1))) { i2c_stop(b); return -1; }
+	for (int i = 0; i < len; i++) {
+		if (i2c_wbyte(b, data[i])) { i2c_stop(b); return -1; }
+	}
+	i2c_stop(b);
+	return 0;
+}
+
+static int
+i2c_write_read(struct bbi2c *b, uint8_t addr, const uint8_t *wd, int wlen,
+    uint8_t *rd, int rlen)
+{
+	i2c_start(b);
+	if (i2c_wbyte(b, (uint8_t)(addr << 1))) { i2c_stop(b); return -1; }
+	for (int i = 0; i < wlen; i++) {
+		if (i2c_wbyte(b, wd[i])) { i2c_stop(b); return -1; }
+	}
+	i2c_start(b);               /* repeated start */
+	if (i2c_wbyte(b, (uint8_t)((addr << 1) | 1))) { i2c_stop(b); return -1; }
+	for (int i = 0; i < rlen; i++) {
+		rd[i] = i2c_rbyte(b, i != rlen - 1);
+	}
+	i2c_stop(b);
+	return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+/* sec_ts / slsi_ts command set (verified against kernel/drivers/input/     */
+/* touchscreen/sec_ts/sec_ts.h on the s21 Linux tree -- NOT assumed)        */
+
+#define SEC_TS_ADDR                   0x48U
+#define SEC_TS_CMD_SENSE_ON           0x10U
+#define SEC_TS_READ_FIRMWARE_INTEGRITY 0x21U
+#define SEC_TS_READ_DEVICE_ID        0x22U
+#define SEC_TS_READ_PANEL_INFO       0x23U
+#define SEC_TS_READ_ONE_EVENT        0x60U
+#define SEC_TS_READ_ALL_EVENT        0x61U
+#define SEC_TS_CMD_CLEAR_EVENT_STACK 0x62U
+
+static struct bbi2c ts_i2c, pmic_i2c;
+
+static char summary[1024];
+static void note(const char *fmt, ...) __printflike(1, 2);
+static void
+note(const char *fmt, ...)
+{
+	char line[192];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("sweet_touch: %s\n", line);
+	size_t used = strlen(summary);
+	if (used + strlen(line) + 2 < sizeof(summary)) {
+		strlcat(summary, line, sizeof(summary));
+		strlcat(summary, "; ", sizeof(summary));
+	}
+}
+
+/* ------------------------------------------------------------------------ */
+/* S2DOS05 PMIC power-up (same LDO2/LDO3 as the S20+'s redwood_sec_ts.c)    */
+
+#define S2DOS05_ADDR 0x60U
+#define S2DOS05_EN       0x03U  /* bit1 LDO2 tsp_io, bit2 LDO3 tsp_avdd */
+#define S2DOS05_LDO2_CFG 0x05U  /* 1.8V = 0x0C */
+#define S2DOS05_LDO3_CFG 0x06U  /* 3.0V = 0x0C */
+
+static int
+s2dos05_power(int on)
+{
+	uint8_t w[2];
+	uint8_t en;
+
+	/* read EN */
+	w[0] = S2DOS05_EN;
+	if (i2c_write_read(&pmic_i2c, S2DOS05_ADDR, w, 1, &en, 1)) {
+		note("S2DOS05 read EN failed (nak -- may be unpowered or not on this bus)");
+		return -1;
+	}
+
+	if (!on) {
+		return 0; /* leave it; touch_pwr=0 path never gets here */
+	}
+
+	w[0] = S2DOS05_LDO2_CFG; w[1] = 0x0C;
+	i2c_write(&pmic_i2c, S2DOS05_ADDR, w, 2);
+	w[0] = S2DOS05_LDO3_CFG; w[1] = 0x0C;
+	i2c_write(&pmic_i2c, S2DOS05_ADDR, w, 2);
+
+	en |= (1U << 1);
+	w[0] = S2DOS05_EN; w[1] = en;
+	i2c_write(&pmic_i2c, S2DOS05_ADDR, w, 2);
+	sleep_us(1000);
+
+	en |= (1U << 2);
+	w[0] = S2DOS05_EN; w[1] = en;
+	i2c_write(&pmic_i2c, S2DOS05_ADDR, w, 2);
+	sleep_us(100000);
+
+	note("S2DOS05 EN now 0x%02x", en);
+	return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Event decode -- struct sec_ts_event_coordinate, bit-for-bit from the     */
+/* vendor header, NOT the S20+ doc's byte-shift description (they agree,   */
+/* this is just the authoritative source for this SoC's driver generation) */
+
+struct ts_touch {
+	int id, down, x, y, z, major, minor;
+};
+
+static int
+decode_event(const uint8_t *e, struct ts_touch *t)
+{
+	uint8_t eid = e[0] & 0x3;
+	if (eid != 0x3) { /* 0x3 = coordinate event in this struct's eid field */
+		/* not a coordinate record: status/gesture event, or empty (eid==0 && byte==0) */
+		return 0;
+	}
+	t->id     = (e[0] >> 2) & 0xF;
+	t->down   = ((e[0] >> 6) & 0x3) != 0;   /* tchsta: 0 = up, nonzero = down/move */
+	t->x      = (e[1] << 4) | (e[3] & 0xF);
+	t->y      = (e[2] << 4) | ((e[3] >> 4) & 0xF);
+	t->major  = e[4];
+	t->minor  = e[5];
+	t->z      = e[6] & 0x3F;
+	return 1;
+}
+
+/* ------------------------------------------------------------------------ */
+/* TODO: wire into SWEET's real input posting path. Paste back sweet_keys.c */
+/* (or whatever registers synthetic events with the SWEET HID stand-in) and */
+/* I'll fill this in for real instead of leaving a printf.                  */
+
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+#define S21_PANEL_MAXX 1079
+#define S21_PANEL_MAXY 2399
+
+static void
+sweet_touch_post(struct ts_touch *t, uint32_t flip)
+{
+        int x = t->x, y = t->y;
+        if (flip & 1) { x = S21_PANEL_MAXX - x; }
+        if (flip & 2) { y = S21_PANEL_MAXY - y; }
+        sweet_hid_touch(t->id, t->down ? 1 : 0, x, y);
+}
+
+/* ------------------------------------------------------------------------ */
+
+void sweet_touch_init(void);
+
+void
+sweet_touch_init(void)
+{
+	int touch_ts = 0, touch_pwr = 0, touch_flip = 0, touch_trace = 0, touch_pull = 0;
+	uint32_t touch_poll_us = 8000;
+
+	if (!PE_parse_boot_argn("touch_ts", &touch_ts, sizeof(touch_ts))) {
+		return; /* nothing unless explicitly asked, same convention as the rest of SWEET */
+	}
+	PE_parse_boot_argn("touch_pwr", &touch_pwr, sizeof(touch_pwr));
+	PE_parse_boot_argn("touch_pull", &touch_pull, sizeof(touch_pull));
+	PE_parse_boot_argn("touch_flip", &touch_flip, sizeof(touch_flip));
+	PE_parse_boot_argn("touch_trace", &touch_trace, sizeof(touch_trace));
+	PE_parse_boot_argn("touch_poll_us", &touch_poll_us, sizeof(touch_poll_us));
+
+	ts_bus_va   = ml_io_map(TS_BUS_BASE, 0x20);
+	pmic_bus_va = ml_io_map(PMIC_BUS_BASE, 0x20);
+	attn_va     = ml_io_map(ATTN_BASE, 0x20);
+
+	ts_i2c.bank_va   = ts_bus_va;   ts_i2c.scl_bit   = TS_SCL_BIT;   ts_i2c.sda_bit   = TS_SDA_BIT;
+	pmic_i2c.bank_va = pmic_bus_va; pmic_i2c.scl_bit = PMIC_SCL_BIT; pmic_i2c.sda_bit = PMIC_SDA_BIT;
+
+	/* ATTN as input, weak pull-up (matches the DTS's tsp_attn_input state) */
+	pin_func(attn_va, ATTN_BIT, FUNC_INPUT);
+
+	if (touch_ts == 4) {
+		uint32_t tcon = *(volatile uint32_t *)(ts_bus_va + REG_CON);
+		uint32_t pcon = *(volatile uint32_t *)(pmic_bus_va + REG_CON);
+		uint32_t tpud = *(volatile uint32_t *)(ts_bus_va + REG_PUD);
+		char ts_acks[64] = "", pm_acks[64] = "";
+		size_t tl = 0, pl = 0;
+		if (touch_pull) {
+			/* gpp4-0/1: 2 bits per pin, 3 = pull-up (assumed width) */
+			*(volatile uint32_t *)(ts_bus_va + REG_PUD) = (tpud & ~0xFU) | 0xFU;
+			sleep_us(1000);
+		}
+		i2c_scl(&ts_i2c, 1); i2c_sda(&ts_i2c, 1);
+		i2c_scl(&pmic_i2c, 1); i2c_sda(&pmic_i2c, 1);
+		sleep_us(2000);
+		note("DIAG con ts=%08x pmic=%08x pud ts=%08x pull=%d idle ts scl%d sda%d pmic scl%d sda%d",
+		    tcon, pcon, tpud, touch_pull,
+		    pin_get(ts_i2c.bank_va, ts_i2c.scl_bit), pin_get(ts_i2c.bank_va, ts_i2c.sda_bit),
+		    pin_get(pmic_i2c.bank_va, pmic_i2c.scl_bit), pin_get(pmic_i2c.bank_va, pmic_i2c.sda_bit));
+		for (uint32_t a = 0x08; a < 0x78; a++) {
+			i2c_start(&ts_i2c);
+			int nk = i2c_wbyte(&ts_i2c, (uint8_t)(a << 1));
+			i2c_stop(&ts_i2c);
+			if (!nk && tl + 4 < sizeof(ts_acks)) {
+				tl += (size_t)snprintf(ts_acks + tl, sizeof(ts_acks) - tl, "%02x ", a);
+			}
+			i2c_start(&pmic_i2c);
+			nk = i2c_wbyte(&pmic_i2c, (uint8_t)(a << 1));
+			i2c_stop(&pmic_i2c);
+			if (!nk && pl + 4 < sizeof(pm_acks)) {
+				pl += (size_t)snprintf(pm_acks + pl, sizeof(pm_acks) - pl, "%02x ", a);
+			}
+		}
+		note("scan ts ack: [%s] pmic ack: [%s]", ts_acks, pm_acks);
+		panic("sweet_touch: %s", summary);
+	}
+
+	if (touch_pwr >= 1) {
+		if (touch_pwr == 2) {
+			uint8_t w[2] = { S2DOS05_EN, 0 };
+			uint8_t en;
+			if (!i2c_write_read(&pmic_i2c, S2DOS05_ADDR, w, 1, &en, 1)) {
+				en &= ~((1U << 1) | (1U << 2));
+				w[1] = en;
+				i2c_write(&pmic_i2c, S2DOS05_ADDR, w, 2);
+				sleep_us(50000);
+			}
+		}
+		s2dos05_power(1);
+	} else {
+		note("touch_pwr=0: leaving S2DOS05 alone (DT marks LDO2/3 boot-on + always-on)");
+	}
+
+	sleep_us(50000); /* controller boot time, generous first guess */
+
+	uint8_t cmd, id[5] = {0};
+	cmd = SEC_TS_READ_DEVICE_ID;
+	if (i2c_write_read(&ts_i2c, SEC_TS_ADDR, &cmd, 1, id, 5)) {
+		note("device ID read failed (nak) -- bus or power problem");
+		if (touch_ts == 2) {
+			panic("sweet_touch: %s", summary);
+		}
+		return;
+	}
+	note("device ID: %02x %02x %02x %02x %02x", id[0], id[1], id[2], id[3], id[4]);
+
+	cmd = SEC_TS_CMD_SENSE_ON;
+	i2c_write(&ts_i2c, SEC_TS_ADDR, &cmd, 1);
+	cmd = SEC_TS_CMD_CLEAR_EVENT_STACK;
+	i2c_write(&ts_i2c, SEC_TS_ADDR, &cmd, 1);
+
+	if (touch_ts == 2) {
+		panic("sweet_touch: probe ok: %s", summary);
+	}
+	if (touch_ts == 3) {
+		return; /* probe only */
+	}
+
+	/* touch_ts == 1: poll ATTN, read and post events */
+	for (;;) {
+		if (pin_get(attn_va, ATTN_BIT) == 0) { /* low = events pending */
+			uint8_t ev[8];
+			cmd = SEC_TS_READ_ONE_EVENT;
+			if (i2c_write_read(&ts_i2c, SEC_TS_ADDR, &cmd, 1, ev, 8) == 0) {
+				struct ts_touch t;
+				if (decode_event(ev, &t)) {
+					if (touch_trace) {
+						note("raw %02x %02x %02x %02x %02x %02x %02x %02x",
+						    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+					}
+					sweet_touch_post(&t, (uint32_t)touch_flip);
+				}
+			}
+		}
+		sleep_us(touch_poll_us);
+	}
+}
