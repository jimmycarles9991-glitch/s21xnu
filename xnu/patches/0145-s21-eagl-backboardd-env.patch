diff --git a/bsd/dev/s21_eagl.c b/bsd/dev/s21_eagl.c
new file mode 100644
index 0000000..1713e0b
--- /dev/null
+++ b/bsd/dev/s21_eagl.c
@@ -0,0 +1,83 @@
+/*
+ * S21 EAGL injection for the render server.
+ *
+ * iOS 16's CoreAnimation falls back to OpenGL ES when Metal is unavailable.
+ * The Mesa-backed shim (/usr/bin/libs21eagl.dylib) must be present in
+ * backboardd for that fallback to reach Panfrost.  The cached launchd job's
+ * DYLD_INSERT_LIBRARIES was not honoured on the platform binary, so append
+ * the variable from exec_extract_strings() instead.  Only the first two
+ * backboardd launches of a boot get the shim: a broken dylib costs two
+ * restarts, after which the render server starts stock.
+ *
+ * boot-arg s21eagl=0 disables injection (default 1).  The dylib path is
+ * checked with vnode_lookup() so kernels booted with older images simply
+ * carry on without a shim.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <string.h>
+#include <pexpert/pexpert.h>
+
+int s21_eagl_env(const char *path, int pid, const char **extra, int max);
+uint64_t s21_eagl_dyld_flags(void);
+
+#define S21EAGL_TARGET         "/usr/libexec/backboardd"
+#define S21EAGL_SHIM           "/usr/bin/libs21eagl.dylib"
+#define S21EAGL_MAX_LAUNCHES   2
+#define S21EAGL_AMFI_FLAGS     0x7bull
+
+static int s21eagl_mode = -1;
+static int s21eagl_launches;
+static int s21eagl_pid = -1;
+
+/*
+ * The existing global AMFI stand-in already answers 0x7b to every dyld
+ * policy call.  This query exists only to mark the injected process in the
+ * log; its value is the same, so other processes keep their current answer.
+ */
+uint64_t
+s21_eagl_dyld_flags(void)
+{
+	if (s21eagl_pid < 0 || proc_selfpid() != s21eagl_pid) {
+		return 0;
+	}
+	return S21EAGL_AMFI_FLAGS;
+}
+
+int
+s21_eagl_env(const char *path, int pid, const char **extra, int max)
+{
+	if (s21eagl_mode < 0) {
+		s21eagl_mode = 1;
+		PE_parse_boot_argn("s21eagl", &s21eagl_mode, sizeof(s21eagl_mode));
+	}
+	if (s21eagl_mode == 0 || path == NULL ||
+	    strcmp(path, S21EAGL_TARGET) != 0 || max < 1) {
+		return 0;
+	}
+
+	int launch = ++s21eagl_launches;
+	if (launch > S21EAGL_MAX_LAUNCHES) {
+		printf("S21EAGL-kernel: backboardd launch %d: stock (limit %d)\n",
+		    launch, S21EAGL_MAX_LAUNCHES);
+		return 0;
+	}
+
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(S21EAGL_SHIM, 0, &vp, vfs_context_kernel()) != 0) {
+		printf("S21EAGL-kernel: backboardd launch %d: no %s, stock\n",
+		    launch, S21EAGL_SHIM);
+		return 0;
+	}
+	vnode_put(vp);
+
+	s21eagl_pid = pid;
+	extra[0] = "DYLD_INSERT_LIBRARIES=" S21EAGL_SHIM;
+	printf("S21EAGL-kernel: backboardd launch %d (pid %d): injected %s\n",
+	    launch, pid, S21EAGL_SHIM);
+	return 1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 68612db..67e8fca 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5741,6 +5741,28 @@ exec_extract_strings(struct image_params *imgp)
 		imgp->ip_envc++;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* bsd/dev/s21_eagl.c: the Mesa EAGL shim for backboardd. */
+	{
+		extern int s21_eagl_env(const char *path, int pid, const char **extra, int max);
+		const char *extra[1];
+		int n = s21_eagl_env(imgp->ip_strings + strlen(EXECUTABLE_KEY),
+		    proc_getpid(vfs_context_proc(imgp->ip_vfs_context)), extra, 1);
+		for (int i = 0; i < n; i++) {
+			error = exec_add_user_string(imgp, CAST_USER_ADDR_T(extra[i]), UIO_SYSSPACE, TRUE);
+			if (error) {
+				goto bad;
+			}
+			if (imgp->ip_argspace < new_ptr_size) {
+				error = E2BIG;
+				goto bad;
+			}
+			imgp->ip_argspace -= new_ptr_size;
+			imgp->ip_envc++;
+		}
+	}
+#endif
+
 	/* Save space for envv[] NULL terminator */
 	if (imgp->ip_argspace < new_ptr_size) {
 		error = E2BIG;
