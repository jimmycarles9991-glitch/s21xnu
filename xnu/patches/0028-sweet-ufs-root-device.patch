+static void
+ufs_config_host(uint32_t mhz, struct ufs_vs_handle *vh)
+{
+	uint32_t r;
+	r = ufs_rd(0x11B4); ufs_wr(0x11B4, r & ~(1u << 4));
+	r = ufs_rd(0x118C); ufs_wr(0x118C, r | (1u << 16));
+	ufs_wr(0x110C, mhz & 0x3ff);
+	ufs_wr(0x1160, 0xA);
+	ufs_wr(0x1100, (1u << 31) | 12);
+	ufs_wr(0x1104, 12);
+	ufs_wr(0x1140, 0xFFFFFFFF);
+	ufs_wr(0x1144, 0xFFFFFFFF);
+	ufs_wr(0x116C, (1u << 31) | (3u << 27) | 3);
+	r = ufs_rd(0x1200); ufs_wr(0x1200, r & ~1u);
+	unipro_writel(vh, 0x90913C1C, 0x39A8);
+	unipro_writel(vh, 0xE01C115F, 0x39B4);
+}
