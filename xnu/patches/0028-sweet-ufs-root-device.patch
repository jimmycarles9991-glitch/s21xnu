+static void
+ufs_link_bringup(void)
+{
+	int i, t, ok = 0;
+	uint32_t is = 0, a2 = 0, mhz;
+	static struct ufs_cal_param cp;
+	static struct ufs_vs_handle vh;
+	enum ufs_cal_errno cr;
+
+	mhz = ufs_rd(0x110C) & 0x3ff;
+	if (!mhz) { mhz = 166; }
+	vh.unipro = (void *)ml_io_map(0x13180000, 0x10000);
+	vh.pma = (void *)ml_io_map(0x13104000, 0x4000);
+	vh.udelay = sweet_cal_udelay;
+	cp.handle = &vh; cp.mclk_rate = mhz * 1000000u; cp.available_lane = 2;
+	cp.board = BRD_UNIV; cp.tbl = 0; cp.evt_ver = 1; cp.max_gear = 4;
+	SULOG("SWEET UFS: b1 mclk %u MHz clkstop 0x%x forcehcs 0x%x\n", mhz, ufs_rd(0x11B0), ufs_rd(0x11B4));
+	ufs_wr(REG_HCE, 0);
+	for (i = 0; i < 1000 && (ufs_rd(REG_HCE) & 1); i++) { delay(10); }
+	SULOG("SWEET UFS: b2 config_host\n");
+	ufs_config_host(mhz, &vh);
+	SULOG("SWEET UFS: b3 device reset\n");
+	ufs_wr(0x1170, 0); delay(5); ufs_wr(0x1170, 1); delay(10000);
+	ufs_wr(REG_HCE, 1);
+	for (i = 0; i < 1000 && !(ufs_rd(REG_HCE) & 1); i++) { delay(10); }
+	ufs_wr(0x11B0, 0);
+	for (i = 0; i < 1000 && !(ufs_rd(REG_HCS) & 8); i++) { delay(100); }
+	SULOG("SWEET UFS: b4 hce 0x%x hcs 0x%x clkstop 0x%x txprdt 0x%x\n", ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(0x11B0), ufs_rd(0x1100));
+	for (t = 0; t < 3 && !ok; t++) {
+		SULOG("SWEET UFS: b5 pre_link try %d\n", t);
+		cr = ufs_cal_pre_link(&cp);
+		SULOG("SWEET UFS: pre_link -> %d\n", (int)cr);
+		ufs_wr(REG_IS, ufs_rd(REG_IS));
+		ufs_wr(0x94, 0); ufs_wr(0x98, 0); ufs_wr(0x9c, 0);
+		ufs_wr(0x90, 0x16);
+		for (i = 0; i < 20000 && !(ufs_rd(REG_IS) & (1u << 10)); i++) { delay(100); }
+		is = ufs_rd(REG_IS); a2 = ufs_rd(0x98);
+		SULOG("SWEET UFS: linkstartup try %d is 0x%x arg2 0x%x hcs 0x%x\n", t, is, a2, ufs_rd(REG_HCS));
+		SULOG("SWEET UFS: uec pa 0x%x dl 0x%x n 0x%x t 0x%x dme 0x%x\n", ufs_rd(0x38), ufs_rd(0x3c), ufs_rd(0x40), ufs_rd(0x44), ufs_rd(0x48));
+		ufs_wr(REG_IS, is);
+		if ((is & (1u << 10)) && !(a2 & 0xff) && (ufs_rd(REG_HCS) & 1)) { ok = 1; }
+	}
+	if (ok) {
+		SULOG("SWEET UFS: link UP, tx? 0x%x rx? 0x%x (offsets inferred)\n", unipro_readl(&vh, 0x3184), unipro_readl(&vh, 0x3204));
+		cp.connected_tx_lane = 2; cp.connected_rx_lane = 2;
+		cr = ufs_cal_post_link(&cp);
+		SULOG("SWEET UFS: post_link -> %d hcs 0x%x\n", (int)cr, ufs_rd(REG_HCS));
+	}
+	{ static bool held; if (!held) { held = true; uint64_t w; nanoseconds_to_absolutetime(45000000000ULL, &w); w += mach_absolute_time(); while (mach_absolute_time() < w) { } } }
+}
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	SULOG("SWEET UFS: entry hce 0x%x hcs 0x%x\n", hce, hcs);
+	if (!(hce & 1)) {
+		ufs_wr(REG_HCE, 1);
+		for (int i = 0; i < 200000 && !(ufs_rd(REG_HCE) & 1); i++) { }
+		hce = ufs_rd(REG_HCE); hcs = ufs_rd(REG_HCS);
+		SULOG("SWEET UFS: tried HCE=1 -> hce 0x%x hcs 0x%x\n", hce, hcs);
+		ufs_link_bringup();
+		hce = ufs_rd(REG_HCE); hcs = ufs_rd(REG_HCS);
+		SULOG("SWEET UFS: after bringup hce 0x%x hcs 0x%x\n", hce, hcs);
+	}
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		SULOG("SWEET UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		SULOG("SWEET UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		SULOG("SWEET UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+sweet_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+sweet_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(su.first_block + lba, blocks);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const void *)(su.dma + DMA_BOUNCE + skip), want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+sweet_ufs_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw sweet_ufs_bdevsw = {
+	.d_open     = sweet_ufs_open,
+	.d_close    = sweet_ufs_close,
+	.d_strategy = sweet_ufs_strategy,
+	.d_ioctl    = sweet_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_ufs_cdevsw = {
+	.d_open       = sweet_ufs_open,
+	.d_close      = sweet_ufs_close,
+	.d_read       = sweet_ufs_read,
+	.d_write      = sweet_ufs_write,
+	.d_ioctl      = sweet_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		SULOG("SWEET UFS: no /sweet-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		SULOG("SWEET UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* The first command after the bootloader may report a unit attention. */
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0)); i++) {
+		}
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	su.ready = true;
+	SULOG("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, read-only\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20);
+	return 0;
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int sweet_ufs_rootdev(dev_t *dev);
+
+int
+sweet_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = sweet_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
