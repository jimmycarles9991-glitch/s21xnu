diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_ufs.c
@@ -0,0 +1,2349 @@
+/*
+ * SWEET internal UFS root device (read-only), Samsung Exynos 2100 (S21).
+ *
+ * The host is NOT usable at takeover (Linux's kexec shutdown stops it, HCE=0),
+ * so this driver does the whole bring-up itself, mirroring the Linux driver
+ * that works on the phone (ufs-e2100-drv.c + vendor CAL): PMU/sysreg pokes,
+ * FMP_SECURITY and SMU_INIT SMCs, host sw reset, config_host, device reset,
+ * HCE, CAL pre/post link, DME_LINKSTARTUP, NOP OUT and fDeviceInit. Then it
+ * issues polled SCSI READs to LUN 0, one at a time, finds one GPT partition
+ * by name (boot-arg ufsroot=, default "userdata") and exposes it as the BSD
+ * disk ufsroot0 (rufsroot0), 512-byte logical sectors over 4 KiB device blocks.
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is driven non-coherent (IOCC cleared, as
+ * the Linux DT does), so caches are cleaned/invalidated around each command.
+ * Writes are refused.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (1u << 20)
+#define PRDT_CHUNK      4096u                   /* Linux max_segment_size for this host */
+#define PRDT_ENT        128u                    /* sg_entry_size with FMP descriptor type 3 */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define UCD_PRDT_OFF    1024u                   /* command UPIU 512 + response UPIU 512 */
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, BYTES (PRDT_BYTE_GRAN) */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	uint8_t prdt[PRDT_MAX * PRDT_ENT];
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x10000                 /* UCD is 1 KiB + 32 KiB of PRDT */
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} su;
+
+static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
+static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+/* Vendor HCI_UTRL_NEXUS_TYPE (ufs-vs-regs.h 0x40 in the "hci" block at 0x1100): bit set = SCSI, clear = devman/query. */
+#define SU_NEXUS_UTRL   0x1140u
+
+/* Diagnostics: printed live and kept for the IOFindBSDRoot panic string. */
+static char su_dbg[1100];
+static unsigned su_dbg_n;
+#define SULOG(...) do { printf(__VA_ARGS__); if (su_dbg_n < sizeof(su_dbg) - 120) { snprintf(su_dbg + su_dbg_n, sizeof(su_dbg) - su_dbg_n, __VA_ARGS__); su_dbg_n = (unsigned)strlen(su_dbg); } } while (0)
+
+static const uint8_t *
+ufs_resp(void)
+{
+	return ((struct ucd *)(su.dma + DMA_UCD))->resp;
+}
+
+/* Reset the transfer list after a failed or timed-out request. */
+static void
+ufs_list_reset(void)
+{
+	ufs_wr(REG_UTRLRSR, 0);
+	ufs_wr(REG_UTRLCLR, 1u);                /* UFSHCI_QUIRK_BROKEN_REQ_LIST_CLR: write 1 to clear, not ~1 */
+	ufs_wr(REG_UTRLRSR, 1);
+}
+
+/*
+ * One request in slot 0. upiu is the 32-byte command/request UPIU. scsi picks
+ * the nexus type. datalen is the device-to-host byte count into the bounce
+ * buffer (0 = none). The PRDT uses the Exynos layout the Linux driver sets up:
+ * 128-byte entries (ufshcd_set_sg_entry_size) of at most 4096 bytes
+ * (max_segment_size), and with UFSHCD_QUIRK_PRDT_BYTE_GRAN the PRDT length
+ * field counts bytes, not entries. Read direction only.
+ */
+static int
+ufs_xfer(const uint8_t *upiu, bool scsi, uint32_t datalen, uint64_t timeout_ns)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+	uint32_t n = (datalen + PRDT_CHUNK - 1) / PRDT_CHUNK, prdt_bytes = n * PRDT_ENT;
+
+	assert(datalen <= BOUNCE_SIZE);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, UCD_PRDT_OFF + prdt_bytes);
+	memcpy(ucd->cmd, upiu, 32);
+
+	utrd->dw0 = (1u << 28) | ((datalen ? 2u : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u << 16) | 512u;      /* PRDT_BYTE_GRAN: bytes */
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t *e = (uint32_t *)(void *)(ucd->prdt + i * PRDT_ENT);
+		uint64_t pa = bounce_pa + (uint64_t)i * PRDT_CHUNK;
+		e[0] = (uint32_t)pa;
+		e[1] = (uint32_t)(pa >> 32);
+		e[2] = 0;
+		e[3] = MIN(PRDT_CHUNK, datalen - i * PRDT_CHUNK) - 1;
+	}
+	if (n) {
+		utrd->prdt = (UCD_PRDT_OFF << 16) | prdt_bytes;
+	}
+
+	uint32_t nx = ufs_rd(SU_NEXUS_UTRL);
+	ufs_wr(SU_NEXUS_UTRL, scsi ? (nx | 1u) : (nx & ~1u));
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, UCD_PRDT_OFF + prdt_bytes);
+	if (datalen) {
+		dma_sync(DMA_BOUNCE, datalen);
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(timeout_ns, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			SULOG("SWEET UFS: req 0x%02x timeout IS 0x%x HCS 0x%x\n", upiu[0], ufs_rd(REG_IS), ufs_rd(REG_HCS));
+			ufs_list_reset();
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	uint32_t is = ufs_rd(REG_IS);
+	ufs_wr(REG_IS, is);                     /* acknowledge */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, UCD_PRDT_OFF + prdt_bytes);
+	if (datalen) {
+		dma_sync(DMA_BOUNCE, datalen);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs) {
+		SULOG("SWEET UFS: req 0x%02x ocs 0x%x IS 0x%x\n", upiu[0], ocs, is);
+		ufs_list_reset();
+		return EIO;
+	}
+	return 0;
+}
+
+/* One SCSI command, data (if any) to the bounce buffer. */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len)
+{
+	uint8_t upiu[32] = { 0 };
+
+	assert(cdb_len <= 16);
+	upiu[0] = 0x01;                         /* COMMAND UPIU */
+	upiu[1] = len ? 0x40 : 0x00;            /* R: data in */
+	upiu[2] = su.lun;
+	upiu[3] = ++su.tag;
+	upiu[12] = (uint8_t)(len >> 24);
+	upiu[13] = (uint8_t)(len >> 16);
+	upiu[14] = (uint8_t)(len >> 8);
+	upiu[15] = (uint8_t)len;
+	memcpy(&upiu[16], cdb, cdb_len);
+
+	int error = ufs_xfer(upiu, true, len, CMD_TIMEOUT_NS);
+	if (error) {
+		return error;
+	}
+	const uint8_t *r = ufs_resp();
+	if (r[0] != 0x21 || r[6] || r[7]) {
+		SULOG("SWEET UFS: scsi 0x%02x upiu 0x%x resp 0x%x status 0x%x\n", cdb[0], r[0], r[6], r[7]);
+		return EIO;
+	}
+	return 0;
+}
+
+/* NOP OUT / NOP IN: is the device answering at the UPIU level? */
+static int
+ufs_nop(void)
+{
+	uint8_t upiu[32] = { 0 };
+
+	upiu[3] = ++su.tag;
+	int error = ufs_xfer(upiu, false, 0, 100ull * NSEC_PER_MSEC);
+	if (error) {
+		return error;
+	}
+	const uint8_t *r = ufs_resp();
+	if (r[0] != 0x20) {
+		SULOG("SWEET UFS: nop resp upiu 0x%x resp 0x%x at128 0x%x\n", r[0], r[6], r[-384]);
+		return EIO;
+	}
+	return 0;
+}
+
+#define SU_QOP_READ_FLAG        0x05
+#define SU_QOP_SET_FLAG         0x06
+#define SU_FLAG_DEVICE_INIT     0x01
+
+/* Query UPIU on a flag IDN (JESD220 query request/response, 32 bytes). */
+static int
+ufs_query_flag(uint8_t opcode, uint8_t idn, uint8_t *value)
+{
+	uint8_t upiu[32] = { 0 };
+
+	upiu[0] = 0x16;                         /* QUERY REQUEST */
+	upiu[3] = ++su.tag;
+	upiu[5] = (opcode == SU_QOP_READ_FLAG) ? 0x01 : 0x81;   /* standard read / write request */
+	upiu[12] = opcode;
+	upiu[13] = idn;
+	int error = ufs_xfer(upiu, false, 0, 1500ull * NSEC_PER_MSEC);
+	if (error) {
+		return error;
+	}
+	const uint8_t *r = ufs_resp();
+	if (r[0] != 0x36 || r[6]) {
+		SULOG("SWEET UFS: query op %u upiu 0x%x resp 0x%x\n", opcode, r[0], r[6]);
+		return EIO;
+	}
+	if (value) {
+		*value = r[23] & 1;             /* flag is the low byte of the 32-bit value field */
+	}
+	return 0;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("SWEET UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		su.first_block = first;
+		su.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
