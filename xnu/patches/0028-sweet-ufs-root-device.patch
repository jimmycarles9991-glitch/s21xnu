+
+const char *sweet_ufs_dbg(void);
+const char *
+sweet_ufs_dbg(void)
+{
+	return su_dbg;
+}
+static void
+sweet_cal_udelay(uint32_t us)
+{
+	delay(us);
+}
+
+static void
+ufs_config_host(uint32_t mhz, struct ufs_vs_handle *vh)
+{
+	uint32_t r;
+	r = ufs_rd(0x11B4); ufs_wr(0x11B4, r & ~(1u << 4));
+	r = ufs_rd(0x118C); ufs_wr(0x118C, r | (1u << 16));
+	ufs_wr(0x110C, mhz & 0x3ff);
+	ufs_wr(0x1160, 0xA);
+	ufs_wr(0x1100, (1u << 31) | 12);
+	ufs_wr(0x1104, 12);
+	ufs_wr(0x1140, 0xFFFFFFFF);
+	ufs_wr(0x1144, 0xFFFFFFFF);
+	ufs_wr(0x116C, (1u << 31) | (3u << 27) | 3);
+	r = ufs_rd(0x1200); ufs_wr(0x1200, r & ~1u);
+	unipro_writel(vh, 0x90913C1C, 0x39A8);
+	unipro_writel(vh, 0xE01C115F, 0x39B4);
+}
+
+/*
+ * Everything below mirrors ufs-e2100-drv.c (the Linux driver that works on
+ * this phone), in the same order. Register offsets are from ufs-vs-regs.h:
+ * the "hci" block is at 0x1100 from the UFSHCI base.
+ */
+#define SU_HCI_1US      0x110Cu
+#define SU_HCI_SW_RST   0x1150u         /* UFS_SW_RST_MASK = UNIPRO | LINK = 3 */
+#define SU_HCI_GPIO_OUT 0x1170u         /* device reset line */
+#define SU_HCI_CLKSTOP  0x11B0u
+#define SU_HCI_FORCE    0x11B4u
+/* CLK_STOP_ALL = REFCLKOUT(4) | REFCLK(2) | UNIPRO_MCLK(1) | UNIPRO_PCLK(0) */
+#define SU_CLK_STOP_ALL         ((1u << 4) | (1u << 2) | (1u << 1) | (1u << 0))
+/* CLK_STOP_CTRL_EN_ALL = UFSP_DRCG(8) | MPHY_APB(10) | REFCLKOUT(11) | REFCLK(7) | PCLK(6) | MCLK(5) */
+#define SU_CLK_STOP_CTRL_EN_ALL ((1u << 8) | (1u << 10) | (1u << 11) | (1u << 7) | (1u << 6) | (1u << 5))
+
+/* SoC blocks the Linux driver pokes through regmap (DT v32). */
+#define SU_PMU_BASE     0x15860000UL
+#define SU_SYSREG_BASE  0x11020000UL    /* sysreg_hsi1_ufs */
+
+/* Samsung SMCs (kernel/include/soc/samsung/exynos-smc.h). EL1 -> hypervisor/EL3, as Linux's arm_smccc_smc(). */
+#define SU_SMC_FMP_SECURITY     0xC2001810ULL
+#define SU_SMC_SMU              0xC2001850ULL
+
+static uint64_t
+su_smc(uint64_t fid, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	register uint64_t x4 __asm__("x4") = 0;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+	register uint64_t x7 __asm__("x7") = 0;
+	__asm__ volatile ("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    : "r"(x4), "r"(x5), "r"(x6), "r"(x7)
+	    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return x0;
+}
+
+/* regmap_update_bits() equivalent on an ml_io_map()ed block. */
+static void
+su_rmw(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t val)
+{
+	volatile uint32_t *p = (volatile uint32_t *)(base + off);
+	uint32_t v = *p;
+	*p = (v & ~mask) | (val & mask);
+	__builtin_arm_dsb(0xf);
+}
+
+static void
+su_platform_setup(void)
+{
+	vm_offset_t pmu = ml_io_map(SU_PMU_BASE, 0x4000);
+	vm_offset_t sys = ml_io_map(SU_SYSREG_BASE, 0x4000);
+
+	su_rmw(pmu, 0x728, 0x1, 0x1);           /* ufs-phy-iso */
+	su_rmw(sys, 0x700, 0x300000, 0);        /* ufs-iocc: v32 DT has no dma-coherent, so the driver writes 0 */
+	su_rmw(pmu, 0x3e10, 0x8, 1u << 3);     /* phy-tcxo-con, val << 3 */
+	uint64_t r1 = su_smc(SU_SMC_FMP_SECURITY, 0, 0, 3);     /* CFG_DESCTYPE_3: 128-byte PRDT entries */
+	uint64_t r2 = su_smc(SU_SMC_SMU, 0, 0, 0);              /* SMU_INIT */
+	SULOG("SWEET UFS: u1 smc fmp %llx smu %llx\n", (unsigned long long)r1, (unsigned long long)r2);
+}
+
+/* One UIC command. Returns the UIC result code (0 = success) or ETIMEDOUT; arg3 comes back in *val. */
+static int
+su_uic(uint32_t cmd, uint32_t a1, uint32_t a2, uint32_t a3, uint32_t *val)
+{
+	int i;
+
+	for (i = 0; i < 10000 && !(ufs_rd(REG_HCS) & (1u << 3)); i++) {    /* UCRDY */
+		delay(10);
+	}
+	if (!(ufs_rd(REG_HCS) & (1u << 3))) {
+		return ETIMEDOUT;
+	}
+	ufs_wr(REG_IS, 1u << 10);
+	ufs_wr(0x94, a1);
+	ufs_wr(0x98, a2);
+	ufs_wr(0x9c, a3);
+	ufs_wr(0x90, cmd);
+	for (i = 0; i < 20000 && !(ufs_rd(REG_IS) & (1u << 10)); i++) {    /* UCCS */
+		delay(100);
+	}
+	if (!(ufs_rd(REG_IS) & (1u << 10))) {
+		return ETIMEDOUT;
+	}
+	uint32_t res = ufs_rd(0x98) & 0xff;
+	if (val) {
+		*val = ufs_rd(0x9c);
+	}
+	ufs_wr(REG_IS, 1u << 10);
+	return (int)res;
+}
+
+/* Samsung Linux ufs-e2100 does hce PRE (sw reset, config_host, device reset), HCE=1, hce POST. */
+static int
+ufs_hce_enable(uint32_t mhz, struct ufs_vs_handle *vh)
+{
+	int i;
+	uint32_t r;
+
+	ufs_wr(REG_HCE, 0);
+	for (i = 0; i < 1000 && (ufs_rd(REG_HCE) & 1); i++) {
+		delay(10);
+	}
+	ufs_wr(SU_HCI_SW_RST, 3);
+	for (i = 0; i < 100 && (ufs_rd(SU_HCI_SW_RST) & 3); i++) {
+		delay(10);
+	}
+	if (ufs_rd(SU_HCI_SW_RST) & 3) {
+		SULOG("SWEET UFS: u2 sw reset stuck 0x%x\n", ufs_rd(SU_HCI_SW_RST));
+	}
+	ufs_config_host(mhz, vh);
+	ufs_wr(SU_HCI_GPIO_OUT, 0);
+	delay(5);
+	ufs_wr(SU_HCI_GPIO_OUT, 1);
+	delay(10000);
+	ufs_wr(REG_HCE, 1);
+	for (i = 0; i < 1000 && !(ufs_rd(REG_HCE) & 1); i++) {
+		delay(10);
+	}
+	/* POST_CHANGE: clock-stop control on, gates open (only the CLK_STOP_ALL bits, as Linux does). */
+	r = ufs_rd(SU_HCI_FORCE);
+	ufs_wr(SU_HCI_FORCE, r | SU_CLK_STOP_CTRL_EN_ALL);
+	r = ufs_rd(SU_HCI_CLKSTOP);
+	ufs_wr(SU_HCI_CLKSTOP, r & ~SU_CLK_STOP_ALL);
+	SULOG("SWEET UFS: u2 hce 0x%x hcs 0x%x force 0x%x clkstop 0x%x\n", ufs_rd(REG_HCE), ufs_rd(REG_HCS),
+	    ufs_rd(SU_HCI_FORCE), ufs_rd(SU_HCI_CLKSTOP));
+	return (ufs_rd(REG_HCE) & 1) ? 0 : ENXIO;
+}
+
+/* The device may use LCC; mainline ufshcd turns peer TX LCC off after link startup. Best effort. */
+static void
+su_disable_peer_lcc(void)
+{
+	uint32_t lanes = 0;
+
+	if (su_uic(0x03, 0x1561u << 16, 0, 0, &lanes) || lanes == 0 || lanes > 4) {   /* DME_PEER_GET PA_ConnectedTxDataLanes */
+		SULOG("SWEET UFS: u5 lcc skipped (lanes %u)\n", lanes);
+		return;
+	}
+	for (uint32_t i = 0; i < lanes; i++) {
+		int e = su_uic(0x04, (0x0003u << 16) | i, 0, 0, NULL);                      /* DME_PEER_SET TX_LCC_ENABLE = 0 */
+		if (e) {
+			SULOG("SWEET UFS: u5 lcc lane %u -> %d\n", i, e);
+		}
+	}
+}
+
+static int
+ufs_link_bringup(void)
+{
+	int t, ok = 0;
+	uint32_t mhz;
+	static struct ufs_cal_param cp;
+	static struct ufs_vs_handle vh;
+	enum ufs_cal_errno cr;
+
+	mhz = ufs_rd(SU_HCI_1US) & 0x3ff;       /* what the previous owner left; Linux dmesg says 166 MHz */
+	if (!mhz) {
+		mhz = 166;
+	}
+	vh.unipro = (void *)ml_io_map(0x13180000, 0x10000);
+	vh.pma = (void *)ml_io_map(0x13104000, 0x4000);
+	vh.udelay = sweet_cal_udelay;
+	cp.handle = &vh;
+	cp.mclk_rate = mhz * 1000000u;
+	cp.available_lane = 2;                  /* DT ufs,pmd-attr-lane */
+	cp.board = BRD_UNIV;
+	cp.tbl = 0;
+	cp.evt_ver = 1;
+	cp.max_gear = 4;                        /* DT ufs,pmd-attr-gear */
+
+	su_platform_setup();
+	if (ufs_hce_enable(mhz, &vh)) {
+		SULOG("SWEET UFS: HCE did not come up\n");
+		return ENXIO;
+	}
+	for (t = 0; t < 3 && !ok; t++) {
+		cr = ufs_cal_pre_link(&cp);
+		int e = su_uic(0x16, 0, 0, 0, NULL);                                        /* DME_LINKSTARTUP */
+		SULOG("SWEET UFS: u3 try %d pre %d uic %d hcs 0x%x\n", t, (int)cr, e, ufs_rd(REG_HCS));
+		if (e) {
+			SULOG("SWEET UFS: u3 uec pa 0x%x dl 0x%x n 0x%x t 0x%x dme 0x%x\n",
+			    ufs_rd(0x38), ufs_rd(0x3c), ufs_rd(0x40), ufs_rd(0x44), ufs_rd(0x48));
+		}
+		if (!e && (ufs_rd(REG_HCS) & HCS_DP)) {
+			ok = 1;
+		}
+	}
+	if (!ok) {
+		return ENXIO;
+	}
+	cp.connected_tx_lane = (uint8_t)unipro_readl(&vh, 0x3184);      /* UNIP_PA_CONNECTEDTXDATALENS */
+	cp.connected_rx_lane = (uint8_t)unipro_readl(&vh, 0x3204);      /* UNIP_PA_CONNECTEDRXDATALENS */
+	cr = ufs_cal_post_link(&cp);
+	SULOG("SWEET UFS: u4 link up tx %u rx %u post %d\n", cp.connected_tx_lane, cp.connected_rx_lane, (int)cr);
+	su_disable_peer_lcc();
+	return 0;
+}
+
+/* ufshcd_make_hba_operational(): our request list, run bit. */
+static int
+ufs_make_operational(void)
+{
+	uint32_t hcs = ufs_rd(REG_HCS);
+
+	if (!(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		SULOG("SWEET UFS: not ready hcs 0x%x\n", hcs);
+		return ENXIO;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		SULOG("SWEET UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+/* ufshcd_verify_dev_init() + ufshcd_complete_dev_init(): NOP OUT, then set fDeviceInit and wait for it to clear. */
+static int
+ufs_device_init(void)
+{
+	int error = EIO, i;
+	uint8_t flag = 1;
+
+	for (i = 0; i < 10 && (error = ufs_nop()); i++) {
+		delay(10000);
+	}
+	SULOG("SWEET UFS: u6 nop -> %d\n", error);
+	if (error) {
+		return error;
+	}
+	for (i = 0; i < 3 && (error = ufs_query_flag(SU_QOP_SET_FLAG, SU_FLAG_DEVICE_INIT, NULL)); i++) {
+	}
+	if (error) {
+		SULOG("SWEET UFS: u6 set fDeviceInit -> %d\n", error);
+		return error;
+	}
+	for (i = 0; i < 1500 && flag; i++) {
+		error = ufs_query_flag(SU_QOP_READ_FLAG, SU_FLAG_DEVICE_INIT, &flag);
+		if (error) {
+			SULOG("SWEET UFS: u6 read fDeviceInit -> %d\n", error);
+			return error;
+		}
+		if (flag) {
+			delay(1000);
+		}
+	}
+	SULOG("SWEET UFS: u6 fDeviceInit %s after %d ms\n", flag ? "STILL SET" : "done", i);
+	return flag ? ETIMEDOUT : 0;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	/* Linux's kexec shutdown stops the host (HCE reads 0 at takeover), so always do the full init. */
+	SULOG("SWEET UFS: entry hce 0x%x hcs 0x%x cap 0x%x dma 0x%llx\n", ufs_rd(REG_HCE), ufs_rd(REG_HCS),
+	    ufs_rd(0x00), (unsigned long long)su.dma_pa);
+	int error = ufs_link_bringup();
+	if (!error) {
+		error = ufs_make_operational();
+	}
+	if (!error) {
+		error = ufs_device_init();
+	}
+	return error;
+}
+
+static int
+sweet_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+sweet_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+sweet_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	buf_setresid(bp, count);
+	if (!(buf_flags(bp) & B_READ)) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(su.first_block + lba, blocks);
+		if (error) {
+			break;
+		}
+		memcpy(vaddr + done, (const void *)(su.dma + DMA_BOUNCE + skip), want);
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+sweet_ufs_write(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag)
+{
+	return EROFS;
+}
+
+static const struct bdevsw sweet_ufs_bdevsw = {
+	.d_open     = sweet_ufs_open,
+	.d_close    = sweet_ufs_close,
+	.d_strategy = sweet_ufs_strategy,
+	.d_ioctl    = sweet_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_ufs_cdevsw = {
+	.d_open       = sweet_ufs_open,
+	.d_close      = sweet_ufs_close,
+	.d_read       = sweet_ufs_read,
+	.d_write      = sweet_ufs_write,
+	.d_ioctl      = sweet_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+sweet_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		SULOG("SWEET UFS: no /sweet-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		SULOG("SWEET UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* The first command after the bootloader may report a unit attention. */
+		for (int i = 0; i < 10 && (error = ufs_scsi(tur, sizeof(tur), 0)); i++) {
+			delay(20000);
+		}
+		SULOG("\n\n          u7 TUR err=%d hex=0x%x %s\n", error, (unsigned)error, error ? "FAIL" : "OK");
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	su.ready = true;
+	SULOG("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, read-only\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20);
+	return 0;
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int sweet_ufs_rootdev(dev_t *dev);
+
+int
+sweet_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = sweet_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
