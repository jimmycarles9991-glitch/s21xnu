+/* ufsov: RAM overlay. With boot-arg ufsov=1 the root device accepts writes, but they only go
+ * to RAM: this driver has no UFS write command, so nothing reaches the disk. Reads see the
+ * overlay first. All of it is lost at reboot. ufsovmb=N sets the size (default 64 MiB). */
+static void
+su_ov_setup(void)
+{
+	uint32_t on = 0, mb = 64;
+	vm_offset_t a = 0;
+	vm_size_t dsz;
+
+	if (!PE_parse_boot_argn("ufsov", &on, sizeof(on)) || !on) {
+		return;
+	}
+	PE_parse_boot_argn("ufsovmb", &mb, sizeof(mb));
+	if (mb < 8) {
+		mb = 8;
+	}
+	if (mb > SU_OV_MAXCHUNKS) {
+		mb = SU_OV_MAXCHUNKS;
+	}
+	if (!su.nblocks || su.nblocks > SU_OV_MAXBLOCKS) {
+		SULOG("SWEET UFS: ufsov: device too large for the overlay directory (%llu blocks)\n",
+			(unsigned long long)su.nblocks);
+		return;
+	}
+	dsz = ((vm_size_t)su.nblocks * sizeof(uint32_t) + (vm_size_t)PAGE_MASK) & ~(vm_size_t)PAGE_MASK;
+	if (kmem_alloc_contig(kernel_map, &a, dsz, PAGE_MASK, 0, 0,
+		KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		SULOG("SWEET UFS: ufsov: no memory for the overlay directory\n");
+		return;
+	}
+	su_ov_dir = (uint32_t *)a;
+	for (uint32_t i = 0; i < mb; i++) {
+		a = 0;
+		if (kmem_alloc_contig(kernel_map, &a, SU_OV_CHUNK, PAGE_MASK, 0, 0,
+			KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			break;
+		}
+		su_ov_chunk[su_ov_nchunk++] = a;
+	}
+	if (!su_ov_nchunk) {
+		SULOG("SWEET UFS: ufsov: no memory for the overlay pages\n");
+		su_ov_dir = NULL;
+		return;
+	}
+	su_ov_cap = su_ov_nchunk * SU_OV_PAGES;
+	su_ov_nblk = (uint32_t)su.nblocks;
+	su_ov_on = true;
+	SULOG("SWEET UFS: ufsov: RAM overlay on, %u MiB, %u blocks, writes never reach the disk\n",
+		su_ov_nchunk, su_ov_nblk);
+}
+
+static uint8_t *
+su_ov_page(uint32_t idx)
+{
+	idx--;
+	return (uint8_t *)(su_ov_chunk[idx / SU_OV_PAGES] + (vm_offset_t)(idx % SU_OV_PAGES) * UFS_BLOCK);
+}
+
+/* Copy overlaid 4 KiB blocks over data just read from the device. */
+static void
+su_ov_patch_read(caddr_t dst, uint64_t lba, uint32_t skip, uint32_t want)
+{
+	uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+
+	if (lba + blocks > su_ov_nblk) {
+		return;
+	}
+	for (uint32_t i = 0; i < blocks; i++) {
+		uint32_t idx = su_ov_dir[lba + i];
+		uint32_t lo = (i == 0) ? skip : 0;
+		uint32_t hi = (i == blocks - 1) ? (skip + want - i * UFS_BLOCK) : UFS_BLOCK;
+
+		if (idx) {
+			memcpy(dst + (i * UFS_BLOCK + lo - skip), su_ov_page(idx) + lo, hi - lo);
+		}
+	}
+}
+
+/* Store a write into the overlay. pb is the physical block of the first block (for partial blocks). */
+static int
+su_ov_write(caddr_t src, uint64_t lba, uint32_t skip, uint32_t want, uint64_t pb)
+{
+	uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+	int error;
+
+	if (lba + blocks > su_ov_nblk) {
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < blocks; i++) {
+		uint32_t idx = su_ov_dir[lba + i];
+		uint32_t lo = (i == 0) ? skip : 0;
+		uint32_t hi = (i == blocks - 1) ? (skip + want - i * UFS_BLOCK) : UFS_BLOCK;
+
+		if (!idx) {
+			if (su_ov_used >= su_ov_cap) {
+				if (!su_ov_full_said) {
+					su_ov_full_said = true;
+					SULOG("SWEET UFS: ufsov: overlay full (%u pages), failing writes\n", su_ov_cap);
+				}
+				return ENOSPC;
+			}
+			if (lo != 0 || hi != UFS_BLOCK) {
+				error = ufs_read_blocks(pb + i, 1);
+				if (error) {
+					return error;
+				}
+				memcpy(su_ov_page(su_ov_used + 1), (const void *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+			}
+			idx = ++su_ov_used;
+			su_ov_dir[lba + i] = idx;
+		}
+		memcpy(su_ov_page(idx) + lo, src + (i * UFS_BLOCK + lo - skip), hi - lo);
+	}
+	return 0;
+}
