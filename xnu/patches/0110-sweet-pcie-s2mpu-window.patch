+
 	if (assign_bars())
 		return -1;
 	P.mem = swp_map(PA_MEM, SZ_MEM);
@@ -525,5 +569,5 @@
 
 	SWP_LOG("stage 1 v1 level %u gpf0 off 0x%x", level, gpf0_off);
 	r = swp_bringup((int)level);
-	SWP_LOG("stage 1 %s", r ? "FAILED" : "done");
-}
+	SWP_LOG("stage %u %s", level >= 2 ? 2 : 1, r ? "FAILED" : "done");
+}
