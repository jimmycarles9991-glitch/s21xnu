 /* ---- main ------------------------------------------------------------------- */
+/* Exynos HVC interface from the Linux port: HVC_FID_BASE + 0x100. */
+#define SWP_HVC_SET_S2MPU	0xC6000100ULL
+#define SWP_S2MPU_PCIE_GEN2	7
+#define SWP_S2MPU_ATTR_RW	3
+#define SWP_DMA_BASE		0x92400000ULL
+#define SWP_DMA_SIZE		0x01000000ULL
+#define SWP_DMA_GRANULE		0x00008000ULL
+
+static uint64_t swp_set_s2mpu(uint64_t base)
+{
+	register uint64_t x0 __asm__("x0") = SWP_HVC_SET_S2MPU;
+	register uint64_t x1 __asm__("x1") = SWP_S2MPU_PCIE_GEN2;
+	register uint64_t x2 __asm__("x2") = base;
+	register uint64_t x3 __asm__("x3") = SWP_DMA_GRANULE;
+	register uint64_t x4 __asm__("x4") = SWP_S2MPU_ATTR_RW;
+
+	__asm__ volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4) : :
+	    "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return x0;
+}
+
+static int swp_open_dma_window(void)
+{
+	uint64_t off, ret;
+
+	for (off = 0; off < SWP_DMA_SIZE; off += SWP_DMA_GRANULE) {
+		ret = swp_set_s2mpu(SWP_DMA_BASE + off);
+		if (ret) {
+			SWP_LOG("S2MPU PCIE_GEN2 failed at 0x%llx (HVC result 0x%llx)",
+			    SWP_DMA_BASE + off, ret);
+			return -1;
+		}
+	}
+	SWP_LOG("S2MPU PCIE_GEN2 RW window 0x%llx..0x%llx open (%llu x 32 KiB)",
+	    SWP_DMA_BASE, SWP_DMA_BASE + SWP_DMA_SIZE - 1,
+	    SWP_DMA_SIZE / SWP_DMA_GRANULE);
+	return 0;
+}
+
 static int swp_bringup(int level)
 {
 	uint32_t v;
@@ -493,6 +533,10 @@
 	if (level < 2)
 		return 0;
 
+	/* Permit the Wi-Fi function's DMA before setting its bus-master bit. */
+	if (swp_open_dma_window())
