diff -ruN a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c	2026-10-31 15:39:51.479494179 +0000
+++ b/bsd/dev/sweet_touch.c	2026-10-31 15:39:51.480959114 +0000
@@ -409,7 +409,7 @@
 void
 sweet_touch_init(void)
 {
-	int touch_ts = 0, touch_pwr = 0, touch_flip = 0, touch_trace = 0, touch_pull = 0;
+	int touch_ts = 0, touch_pwr = 2, touch_flip = 0, touch_trace = 0, touch_pull = 0;
 	uint32_t touch_poll_us = 8000;
 
 	if (!PE_parse_boot_argn("touch_ts", &touch_ts, sizeof(touch_ts))) {
@@ -515,8 +515,25 @@
 	sleep_us(50000); /* controller boot time, generous first guess */
 
 	uint8_t cmd, id[5] = {0};
-	cmd = SEC_TS_READ_DEVICE_ID;
-	if (i2c_write_read(&ts_i2c, SEC_TS_ADDR, &cmd, 1, id, 5)) {
+	/* S21: Linux's slsi_ts shutdown leaves the IC asleep after kexec. Power-cycle
+	 * (default touch_pwr=2) and retry the ID read, cycling the rails again if it NAKs. */
+	int tries, got = -1;
+	for (tries = 0; tries < 4 && got; tries++) {
+		cmd = SEC_TS_READ_DEVICE_ID;
+		got = i2c_write_read(&ts_i2c, SEC_TS_ADDR, &cmd, 1, id, 5);
+		if (got) {
+			note("device ID read failed (try %d), power-cycling", tries);
+			uint8_t w[2] = { S2DOS05_EN, 0 }, en;
+			if (!i2c_write_read(&pmic_i2c, S2DOS05_ADDR, w, 1, &en, 1)) {
+				w[1] = (uint8_t)(en & ~((1U << 1) | (1U << 2)));
+				i2c_write(&pmic_i2c, S2DOS05_ADDR, w, 2);
+				sleep_us(100000);
+			}
+			s2dos05_power(1);
+			sleep_us(150000);
+		}
+	}
+	if (got) {
 		note("device ID read failed (nak) -- bus or power problem");
 		if (touch_ts == 2) {
 			panic("sweet_touch: %s", summary);
