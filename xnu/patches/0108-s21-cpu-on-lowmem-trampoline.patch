diff -ruN a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp	2026-10-31 16:05:35.232020579 +0000
+++ b/iokit/Kernel/arm/SweetCPU.cpp	2026-10-31 16:05:35.326875283 +0000
@@ -242,6 +242,23 @@
 	IOLog("SWEET CPU: cpu=%u CPU_ON target=0x%x entry_pa=0x%llx context=%u\n",
 	    getCPUNumber(), cpu->phys_id, (uint64_t)entry, getCPUNumber());
 	__builtin_arm_dsb(DSB_SY);
+	/* S21: the kernel lives above 4 GB but every CPU_ON that ever worked (Linux, probes)
+	 * used an entry below 4 GB. Park a 16-byte trampoline in dead low RAM (old shim image)
+	 * and give the hypervisor that address; it just jumps to the real entry. */
+	{
+		extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+		const uint64_t tramp_pa = 0x80300000ULL;
+		volatile uint32_t *t = (volatile uint32_t *)ml_io_map((vm_offset_t)tramp_pa, 0x4000);
+		if (t != NULL) {
+			t[0] = 0x58000050;	/* ldr x16, #8 */
+			t[1] = 0xd61f0200;	/* br  x16 */
+			t[2] = (uint32_t)(entry & 0xffffffffULL);
+			t[3] = (uint32_t)((uint64_t)entry >> 32);
+			__builtin_arm_dsb(DSB_SY);
+			IOLog("SWEET CPU: cpu=%u trampoline at 0x%llx -> 0x%llx\n", getCPUNumber(), tramp_pa, (uint64_t)entry);
+			entry = (vm_offset_t)tramp_pa;
+		}
+	}
 	int32_t rc = sweet_psci_cpu_on(cpu->phys_id, entry, 0 /* context 0 like Linux; non-zero never proven on H-Arx */);
 	IOLog("SWEET CPU: cpu=%u PSCI CPU_ON rc=%d\n", getCPUNumber(), rc);
 	/* cpu_start() discards PE_cpu_start's return; do not silently carry on. */
